# ── Secrets ────────────────────────────────────────────────────────────────
.env

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── ChromaDB data (auto-created at startup, can be large) ──────────────────
# Do NOT commit the chroma_data/ directory — it is rebuilt from uploaded docs.
chroma_data/

# ── Runtime data ───────────────────────────────────────────────────────────
# documents_manifest.json is intentionally NOT git-ignored.
# It must be committed so Render knows which documents are already indexed.
documents_manifest.tmp

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor ─────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Root-level duplicate static assets (canonical copies live in static/) ──
/app.js
/style.css
