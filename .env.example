# ── Agentic AI Customer Support Assistant — environment variables ──────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored so your API key stays private.

# Required: Get your free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model (default: llama-3.3-70b-versatile)
# llama-3.3-70b-versatile  — best quality, supports tool/function calling
# llama3-8b-8192           — faster, lower quality, also supports tools
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: ChromaDB persistence directory (default: ./chroma_data)
# On Render paid plans, set this to the mounted disk path.
# On Render free tier, leave as-is — auto-seeded from sample_policy.txt on startup.
CHROMA_PERSIST_DIR=./chroma_data

# Optional: Corrective RAG relevance threshold used by the agent's search tool
RELEVANCE_THRESHOLD=0.40

# Optional: Minimum retrieved passages before the agent considers a search useful
MIN_MATCH_COUNT=1

# ── Agentic settings ───────────────────────────────────────────────────────

# Max tool-call iterations the agent may take per user turn (default: 5)
AGENT_MAX_ITERATIONS=5

# How long (seconds) an idle session is kept in memory before expiry (default: 1800 = 30 min)
SESSION_TTL_SECONDS=1800
