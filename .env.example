# ── AI Customer Support Assistant — environment variables ──────────────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored so your API key stays private.

# Required: Get your free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama3-8b-8192 (faster, lower quality)
#                mixtral-8x7b-32768 (longer context window)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Endee vector DB URL (default: http://localhost:8080)
ENDEE_URL=http://localhost:8080

# Optional: Corrective RAG relevance threshold (default: 0.40)
# Higher = stricter (fewer answers). Lower = more answers (higher hallucination risk).
RELEVANCE_THRESHOLD=0.40

# Optional: Minimum number of retrieved passages before calling the LLM (default: 1)
MIN_MATCH_COUNT=1
